# /etc/blockseq.env: settings for the Blockseq service.
#
# Every setting is listed. A line starting with # is off and shows the
# default. Remove the # and change the value to use one, then:
#   systemctl restart blockseq
# install.sh writes this file only once and never changes it afterwards; a
# newer copy of this template is in deploy/blockseq.env.example.

# Address and port to listen on. Keep it on localhost and reach Blockseq
# through a TLS proxy (Caddy). A non-local address (e.g. 0.0.0.0:3030) is
# refused unless BLOCKSEQ_PASSWORD or BLOCKSEQ_HOSTS is set.
BLOCKSEQ_ADDR=127.0.0.1:3030

# Password to use Blockseq. Browsers get a sign-in page (90 days, with sign
# out); scripts send it with HTTP basic auth (any username). Changing it signs
# every browser out. Recommended.
#BLOCKSEQ_PASSWORD=

# Host names Blockseq answers to, comma-separated (IP addresses and localhost
# always work). Blocks "DNS rebinding" by other websites. Set it to the name
# in your browser's address bar.
#BLOCKSEQ_HOSTS=notes.example.com

# Address(es) of your reverse proxy, comma-separated. Its X-Forwarded-For is
# then believed (the wrong-password limit sees each real client) and the
# sign-in cookie is marked Secure when it reports HTTPS.
#BLOCKSEQ_TRUSTED_PROXIES=10.0.0.1

# Largest single upload (images, files, backup restores) in MB.
#BLOCKSEQ_MAX_UPLOAD_MB=256

# Set to 1 to show full server paths in the browser (Assets, workbooks, the
# usage tooltip). Unset: paths relative to the data folder.
#BLOCKSEQ_EXPOSE_PATHS=1

# Data folder: the Main workbook, workbooks/, config.json, sessions.json and
# backups/. The service sets /var/lib/blockseq. The systemd sandbox only lets
# Blockseq write there, so a different folder also needs ReadWritePaths= in
# blockseq.service changed.
#BLOCKSEQ_DATA=/var/lib/blockseq

# How much the log says (journalctl -u blockseq): error, warn, info, debug.
#RUST_LOG=info
